# Copy to .env (never commit .env) and fill in values.
PORT=3000

# PostgreSQL Connection
# Default works with the local database from docker-compose.yml.
# For Render: replace with the connection string from the Render dashboard and set DATABASE_SSL=true
DATABASE_URL=postgres://thunderpeak:thunderpeak@localhost:5432/thunderpeak

# Set to true for hosted databases such as Render
DATABASE_SSL=false

# NPS API Key - Get free key from https://www.nps.gov/subjects/developer/get-started.htm
NPS_API_KEY=

# Secret used to sign login tokens. At least 32 characters, never committed.
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Number of proxies in front of the app. Leave unset locally. On Render, set it (try 1) so rate limits
# are per visitor. Until it is set on Render, login rate limiting stays off.
# TRUST_PROXY=1

# Header that holds the visitor's real IP, set by the platform and not forgeable by visitors.
# On Render (behind Cloudflare) use cf-connecting-ip. Leave unset locally, or anyone could fake it.
# CLIENT_IP_HEADER=cf-connecting-ip
