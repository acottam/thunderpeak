# Copy to .env (never commit .env) and fill in values.
PORT=3000

# PostgreSQL Connection
# For local development: DATABASE_URL=postgres://thunderpeak:thunderpeak@localhost:5432/thunderpeak
# For Render: Get connection string from Render dashboard and set DATABASE_SSL=true
DATABASE_URL=

# Set to true for hosted databases such as Render
DATABASE_SSL=false

# NPS API Key - Get free key from https://www.nps.gov/subjects/developer/get-started.htm
NPS_API_KEY=
