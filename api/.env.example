# Copy to .env (never commit .env) and fill in values.
PORT=3000

# PostgreSQL Connection
# Default works with the local database from docker-compose.yml.
# For Render: replace with the connection string from the Render dashboard and set DATABASE_SSL=true
DATABASE_URL=postgres://thunderpeak:thunderpeak@localhost:5432/thunderpeak

# Set to true for hosted databases such as Render
DATABASE_SSL=false

# NPS API Key - Get free key from https://www.nps.gov/subjects/developer/get-started.htm
NPS_API_KEY=
